# Variáveis de Ambiente para Desenvolvimento
# Copie este arquivo para .env.local e preencha os valores

# Firebase (desconectado / não utilizado)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# GCP API (desconectado / não utilizado)
VITE_GCP_API_URL=

# Feature Flags
VITE_GCP_ENABLED=false
VITE_CLIENTS_GCP_ENABLED=false
VITE_GROWTHMAP_GCP_ENABLED=false

# Supabase (desconectado / não utilizado)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# GTM Diagnóstico: vazio = mesma origem (rota /api/gtm/* no domínio do site)
VITE_GTM_API_BASE=

# Turnstile: a chave de teste sempre aprova; produção usa vars.TURNSTILE_SITE_KEY no CI
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
