# Variáveis de Ambiente para Desenvolvimento
# Copie este arquivo para .env.local e preencha os valores

# Firebase (obrigatório)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id

# GCP API (obrigatório)
VITE_GCP_API_URL=https://revhackers-api-staging-3na73syj5a-rj.a.run.app

# Relay GHL (obrigatório em produção: sem ele o envio ao CRM é no-op fail-closed)
VITE_GHL_RELAY_URL=/api/ghl.php

# Feature Flags
VITE_GCP_ENABLED=true
VITE_CLIENTS_GCP_ENABLED=true
VITE_GROWTHMAP_GCP_ENABLED=true

# Supabase (fallback)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
