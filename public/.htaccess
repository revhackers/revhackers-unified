Options -MultiViews
RewriteEngine On

# ----------------------------------------------------------------------
# Enforce HTTPS and non-www (SEO best practice for duplicate content)
# ----------------------------------------------------------------------
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,NE,R=301]


# Subdomínios de Aplicação (app.revhackers.com.br ou admin.revhackers.com.br)
RewriteCond %{HTTP_HOST} ^(app|admin)\.revhackers\.com\.br$ [NC]
RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^$ /admin [L,R=301]

# Prevent Apache 301 directory redirect so social crawlers (WhatsApp) get HTTP 200 directly on route URLs
DirectorySlash Off

# Nega acesso direto a logs de auditoria (contêm PII) dentro do webroot
RewriteRule ^logs/ - [F,L]

# Direct file match for pre-rendered route HTML files (prevents 301 redirect for social crawlers)
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/]+)$ $1.html [L]

RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^([^/]+)/?$ $1/index.html [L]

# SPA Fallback: serve /index.html for any route that isn't a real file or directory
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]

# Cache assets (hash no nome = safe to cache forever)
<FilesMatch "\.(js|css|woff2|woff|ttf|png|jpg|jpeg|svg|ico|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# HTML sem cache (pode mudar a qualquer deploy - bypass CDN & LiteSpeed)
<FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
    Header set X-LiteSpeed-Cache-Control "no-cache, no-store, bypass"
    Header set X-HCDN-Cache-Control "no-cache, no-store, bypass"
    Header set X-Cache-Control "no-cache"
</FilesMatch>

# Compressão gzip
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
